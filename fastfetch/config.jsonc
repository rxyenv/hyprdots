{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "auto",
    "source": "~/.config/fastfetch/logo.txt",
    "color": {
      "1": "#cb63f7",
      "2": "#fab363"
    }
  },
  "display": {
    "separator": " ",
    "color": {
      "keys": "#cba6f7",
      "title": "#fab387"
    },
    "percent": {
      "color": {
        "green": "#94e2d5",
        "yellow": "#bb8af4",
        "red": "#f38ba8"
      }
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": ""
    },
    {
      "type": "os",
      "key": "OS",
      "keyWidth": 6
    },
    {
      "type": "kernel",
      "key": "KER",
      "keyWidth": 6
    },
    {
      "type": "uptime",
      "key": "UP",
      "keyWidth": 6
    },
    {
      "type": "packages",
      "key": "PKG",
      "keyWidth": 6
    },
    {
      "type": "shell",
      "key": "SH",
      "keyWidth": 6
    },
    {
      "type": "wm",
      "key": "WM",
      "keyWidth": 6
    }
  ]
}
